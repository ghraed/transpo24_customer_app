# Use these only in the EAS "preview" environment and never commit the real values.
# The staging API must be a separate deployment/database and use STRIPE_SECRET_KEY=sk_test_... .
EXPO_PUBLIC_API_URL="https://api-staging.example.com"
EXPO_PUBLIC_SOCKET_URL="https://api-staging.example.com"
EXPO_PUBLIC_ANDROID_API_URL="https://api-staging.example.com"
EXPO_PUBLIC_ANDROID_SOCKET_URL="https://api-staging.example.com"
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_your_stripe_test_publishable_key"

# Configure only when testing Apple Pay on iOS.
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER="merchant.com.example.transpo24"
EXPO_PUBLIC_STRIPE_MERCHANT_COUNTRY_CODE="CH"
