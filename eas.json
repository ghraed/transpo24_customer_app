{
  "cli": {
    "version": ">= 20.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview"
    },
    "play-test": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "channel": "play-test"
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "ios": {
        "image": "sdk-56",
        "distribution": "store",
        "channel": "production-ios"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.transpo24.com",
        "EXPO_PUBLIC_SOCKET_URL": "https://api.transpo24.com",
        "EXPO_PUBLIC_ANDROID_API_URL": "https://api.transpo24.com",
        "EXPO_PUBLIC_ANDROID_SOCKET_URL": "https://api.transpo24.com"
      },
      "autoIncrement": true
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "production-apk"
    }
  },
  "submit": {
    "play-test": {
      "android": {
        "track": "internal"
      }
    },
    "production": {
      "ios": {
        "appleTeamId": "GQ79L2HQU5",
        "ascAppId": "6826544018"
      },
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
