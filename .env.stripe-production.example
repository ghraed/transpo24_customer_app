# Stripe-only overlay for the EAS production environment (not auto-loaded).
# Copy to .env.stripe-production.local and fill values from the Stripe Dashboard.
# Set the API's STRIPE_MODE to the same value, then rebuild/update the client.
EXPO_PUBLIC_STRIPE_MODE=test
EXPO_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_LIVE_PUBLISHABLE_KEY=
